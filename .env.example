# ---------------------------------------------------------------------------
# LEVELUP — Environment variables
# Copy this file to `.env` and fill in real values.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Prisma Postgres connection string.
# Console → Project → Database → Connection string (pooled TCP).
# Example shape: postgresql://USER:PASSWORD@db.prisma.io:5432/levelup?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/levelup?sslmode=require"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the deployed app.
# Also used to build the booking link inside WhatsApp confirmation messages.
# Localhost links are skipped automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: only used by the seed script to create the initial admin account.
# If omitted, the seed creates admin@levelup.id with password "200209".
SEED_ADMIN_EMAIL="admin@levelup.id"
SEED_ADMIN_USERNAME="adminlevelup"
SEED_ADMIN_PASSWORD="200209"

# Optional: demo customer + demo setups are seeded by default in development.
# Set to "false" in production to skip demo data (demo setups are also skipped
# automatically when NODE_ENV=production unless this is explicitly "true").
SEED_DEMO_DATA="true"

# Optional: URL gambar QRIS statis RESMI dari merchant/acquirer lounge.
# Kosongkan jika belum ada. Aplikasi TIDAK membuat gambar QR sendiri.
# Hanya isi dengan gambar QRIS yang benar-benar terhubung ke rekening merchant.
NEXT_PUBLIC_QRIS_IMAGE_URL=""
